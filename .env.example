PORT=3000
MONGODB_URI=mongodb://localhost:27017/meanstack
JWT_SECRET=change-me-to-a-long-random-string
CLIENT_ORIGIN=http://localhost:4200
UPLOAD_DIR=uploads
LOG_LEVEL=info
# Number of reverse proxies in front of the API (the docker-compose stack sets this to 1)
TRUST_PROXY=0
# How long a login session survives without use (days)
REFRESH_TOKEN_TTL_DAYS=7
