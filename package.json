{
  "name": "meanstack-app",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "start": "pnpm --filter @meanstack/client start",
    "build": "pnpm build:shared && pnpm --filter @meanstack/client build",
    "test": "pnpm --filter @meanstack/client test",
    "build:shared": "pnpm --filter @meanstack/shared build",
    "start:server": "pnpm build:shared && pnpm --filter @meanstack/server start:dev",
    "build:server": "pnpm build:shared && pnpm --filter @meanstack/server build",
    "typecheck:server": "pnpm build:shared && pnpm --filter @meanstack/server typecheck",
    "lint": "pnpm --filter @meanstack/client lint",
    "test:server": "pnpm build:shared && pnpm --filter @meanstack/server test",
    "test:e2e": "pnpm build:shared && pnpm --filter @meanstack/e2e test",
    "typecheck": "pnpm typecheck:server && pnpm --filter @meanstack/e2e exec tsc -p tsconfig.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "engines": {
    "node": "^22.22.3 || >=24.15.0"
  },
  "lint-staged": {
    "*.{ts,html,css,scss,js,json,md,yml,yaml}": "prettier --write"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.9.10"
  }
}
