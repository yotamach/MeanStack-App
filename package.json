{
  "name": "meanstack-app",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "start": "pnpm --filter @meanstack/client start",
    "build": "pnpm build:shared && pnpm --filter @meanstack/client build",
    "test": "pnpm --filter @meanstack/client test",
    "build:shared": "pnpm --filter @meanstack/shared build",
    "start:server": "pnpm build:shared && pnpm --filter @meanstack/server start:dev",
    "build:server": "pnpm build:shared && pnpm --filter @meanstack/server build",
    "typecheck:server": "pnpm build:shared && pnpm --filter @meanstack/server typecheck",
    "lint": "pnpm --filter @meanstack/client lint"
  },
  "engines": {
    "node": "^22.22.3 || >=24.15.0"
  }
}
